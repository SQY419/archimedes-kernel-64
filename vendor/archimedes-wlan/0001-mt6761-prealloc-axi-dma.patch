+/*
+ * MT6761 platform glue for the Gen4M WLAN driver.
+ * The reserved Wi-Fi EMI window must be protected from AP access.
+ */
+#include "precomp.h"
+
+#ifdef CONFIG_MTK_EMI
+#include <mt_emi_api.h>
+
+void kalSetEmiMpuProtection(phys_addr_t emiPhyBase, bool enable)
+{
+}
+
+void kalSetDrvEmiMpuProtection(phys_addr_t emiPhyBase,
+                               uint32_t offset, uint32_t size)
+{
+        struct emi_region_info_t region_info;
+
+        DBGLOG(INIT, INFO,
+               "emiPhyBase: 0x%x, offset: %u, size: %u\n",
+               emiPhyBase, offset, size);
+
+        region_info.start = emiPhyBase + offset;
+        region_info.end = emiPhyBase + offset + size - 1;
+        region_info.region = 29;
+        SET_ACCESS_PERMISSION(region_info.apc, LOCK,
+                              FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN,
+                              FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN,
+                              FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN,
+                              FORBIDDEN, NO_PROTECTION,
+                              FORBIDDEN, NO_PROTECTION);
+        emi_mpu_set_protection(&region_info);
+}
+#endif
