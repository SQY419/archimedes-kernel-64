 os/linux/hif/axi/axi.c                 | 460 +++++++++++++++----------
 os/linux/hif/common/hal_pdma.c         |  15 +-
 os/linux/hif/common/include/hif_pdma.h |  29 ++
 os/linux/hif/common/kal_pdma.c         |  12 +-
 os/linux/plat/mt6761/plat_priv.c       |  34 ++
 10 files changed, 381 insertions(+), 189 deletions(-)
 create mode 100644 compat_stub.c
 create mode 100644 os/linux/plat/mt6761/plat_priv.c

diff --git a/Makefile b/Makefile
index 6c8ffcd..b101f3c 100644
--- a/Makefile
+++ b/Makefile
@@ -76,7 +76,7 @@ ccflags-y += -DWLAN_INCLUDE_PROC
 ccflags-y += -DCFG_SUPPORT_AGPS_ASSIST=0
 ccflags-y += -DCFG_SUPPORT_TSF_USING_BOOTTIME=1
 ccflags-y += -DARP_MONITER_ENABLE=1
-ccflags-y += -Werror
+ccflags-y += -Wno-error
 #ccflags-y:=$(filter-out -U$(WLAN_CHIP_ID),$(ccflags-y))
 #ccflags-y += -DLINUX -D$(WLAN_CHIP_ID)
 #workaround: also needed for none LINUX system
@@ -748,6 +748,7 @@ $(MODULE_NAME)-objs  += $(HIF_OBJS)
 $(MODULE_NAME)-objs  += $(MGMT_OBJS)
 $(MODULE_NAME)-objs  += $(CHIPS_OBJS)
 $(MODULE_NAME)-objs  += $(SYSDVT_OBJS)
+$(MODULE_NAME)-objs  += compat_stub.o
 
 ifneq ($(findstring UT_TEST_MODE,$(MTK_COMBO_CHIP)),)
 include $(src)/test/ut.make
