diff --git a/os/linux/gl_init.c b/os/linux/gl_init.c
index b48d7b3..27c67c1 100644
--- a/os/linux/gl_init.c
+++ b/os/linux/gl_init.c
@@ -5313,6 +5313,7 @@ static void wlanRemove(void)
 /* 1 Module Entry Point */
 static int initWlan(void)
 {
+   pr_err("zain_gl: initWlan enter\n");
 	int ret = 0;
 	struct GLUE_INFO *prGlueInfo = NULL;
 
@@ -5373,6 +5374,7 @@ static int initWlan(void)
 #endif
 
 	wlanCreateWirelessDevice();
+   pr_err("zain_gl: wdev=%p\n", gprWdev[0]);
 	if (gprWdev[0] == NULL)
 		return -ENOMEM;
 
@@ -5386,16 +5388,17 @@ static int initWlan(void)
 	gPrDev = NULL;
 
