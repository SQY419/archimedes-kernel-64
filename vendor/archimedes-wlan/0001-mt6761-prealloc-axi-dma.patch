-		DBGLOG(INIT, ERROR, "of_reserved_mem_device_init failed(%d).\n",
-				ret);
-		goto exit;
+	/*
+	 * Some MT6761 boot chains do not run the built-in reserved-memory
+	 * callback before this vendor module probes. Resolve the DT node
+	 * directly so the preallocated path cannot silently abort.
+	 */
+	if (!gWifiRsvMemPhyBase || !gWifiRsvMemSize) {
+		struct device_node *rmem_np;
+		struct resource rmem_res;
+
+		rmem_np = of_parse_phandle(pdev->dev.of_node,
+					   "memory-region", 0);
+		if (rmem_np &&
+			!of_address_to_resource(rmem_np, 0, &rmem_res)) {
+			gWifiRsvMemPhyBase = rmem_res.start;
+			gWifiRsvMemSize = resource_size(&rmem_res);
+			pr_err("zain_axi: DT reserved memory base=%pa size=0x%llx\\n",
+			       &gWifiRsvMemPhyBase, gWifiRsvMemSize);
+		}
+		if (rmem_np)
+			of_node_put(rmem_np);
 	}
-#else
-	ret = of_dma_configure(&pdev->dev, pdev->dev.of_node, true);
-	if (ret) {
-		DBGLOG(INIT, ERROR, "of_dma_configure failed(%d).\n",
-				ret);
+	if (!gWifiRsvMemPhyBase || !gWifiRsvMemSize) {
+		DBGLOG(INIT, ERROR,
+		       "wifi reserved memory unavailable: base=%pa size=0x%llx\n",
+		       &gWifiRsvMemPhyBase, gWifiRsvMemSize);
+		ret = -ENOMEM;
 		goto exit;
 	}
+	DBGLOG(INIT, INFO,
+	       "wifi reserved memory: base=%pa size=0x%llx\n",
+	       &gWifiRsvMemPhyBase, gWifiRsvMemSize);
+#else
+	of_dma_configure(&pdev->dev, pdev->dev.of_node);
+        ret = of_reserved_mem_device_init(&pdev->dev);
+        if (ret) {
+                DBGLOG(INIT, WARN,
+                       "of_reserved_mem_device_init unavailable(%d); using normal DMA\n",
+                       ret);
+                ret = 0;
+        }
+        {
+                struct device_node *rmem_np;
+                struct resource rmem_res;
+                rmem_np = of_parse_phandle(pdev->dev.of_node, "memory-region", 0);
+                if (rmem_np && !of_address_to_resource(rmem_np, 0, &rmem_res)) {
+                        kalSetDrvEmiMpuProtection(rmem_res.start, 0, resource_size(&rmem_res));
+                        DBGLOG(INIT, ERROR, "zain_axi rmem base=%pa size=0x%llx ret=%d dma_mem=%p\n", &rmem_res.start, (unsigned long long)resource_size(&rmem_res), ret, pdev->dev.dma_mem);
+                }
+                of_node_put(rmem_np);
+        }
 #endif
 
+        connectivity_arch_setup_dma_ops(&pdev->dev, 0, DMA_BIT_MASK(prChipInfo->bus_info->u4DmaMask), NULL, false);
 	dma_mask = DMA_BIT_MASK(prChipInfo->bus_info->u4DmaMask);
 	ret = dma_set_mask_and_coherent(&pdev->dev, dma_mask);
 	if (ret) {
@@ -414,6 +463,7 @@ static bool axiCsrIoremap(struct platform_device *pdev)
 	struct resource res;
 
 	node = of_find_compatible_node(NULL, NULL, "mediatek,wifi");
+                pr_err("zain_axi: fallback node=%p\n", node);
 	if (!node) {
 		DBGLOG(INIT, ERROR, "WIFI-OF: get wifi device node fail\n");
 		return false;
@@ -424,7 +474,6 @@ static bool axiCsrIoremap(struct platform_device *pdev)
 		of_node_put(node);
 		return false;
 	}
-	of_node_put(node);
 
 	g_u8CsrOffset = (u64)res.start;
 	g_u4CsrSize = resource_size(&res);
@@ -442,6 +491,7 @@ static bool axiCsrIoremap(struct platform_device *pdev)
 	/* map physical address to virtual address for accessing register */
 #ifdef CONFIG_OF
 	CSRBaseAddress = of_iomap(node, 0);
+        of_node_put(node);
 #else
 	CSRBaseAddress = ioremap(g_u8CsrOffset, g_u4CsrSize);
 #endif
@@ -475,199 +525,118 @@ static void axiCsrIounmap(struct platform_device *pdev)
 }
 
 #if AXI_CFG_PREALLOC_MEMORY_BUFFER
-static bool axiAllocRsvMem(uint32_t u4Size, struct HIF_MEM *prMem)
