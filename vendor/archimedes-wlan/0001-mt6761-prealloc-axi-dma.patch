+extern void connectivity_arch_setup_dma_ops(struct device *dev, u64 dma_base, u64 size, struct iommu_ops *iommu, bool coherent);
+
 /*******************************************************************************
  *                              C O N S T A N T S
  *******************************************************************************
@@ -100,15 +102,19 @@
 
 static const struct platform_device_id mtk_axi_ids[] = {
 	{	.name = "CONNAC",
+#ifdef MT6632
+                .driver_data = (kernel_ulong_t)&mt66xx_driver_data_mt6632,
