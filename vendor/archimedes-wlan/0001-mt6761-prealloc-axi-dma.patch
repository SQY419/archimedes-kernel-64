+static bool axiAllocRsvMem(uint32_t u4Size, struct HIF_MEM *prMem,
+			   bool fgIsCached)
 {
 	/* 8 bytes alignment */
 	if (u4Size & 7)
 		u4Size += 8 - (u4Size & 7);
