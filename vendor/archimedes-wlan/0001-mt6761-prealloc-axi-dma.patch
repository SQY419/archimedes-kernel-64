-	prMem->va = grMem.pucRsvMemVirBase + grMem.u4Offset;
+	if (fgIsCached)
+		prMem->va = ioremap_cache(prMem->pa, u4Size);
+	else
+		prMem->va = ioremap_nocache(prMem->pa, u4Size);
 	grMem.u4Offset += u4Size;
 
 	return prMem->va != NULL;
 }
 
